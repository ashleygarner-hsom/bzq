#!/usr/bin/env bash

# BZQ ERP CLI Utility Suite
# Google Workspace Enterprise Application Manager

# Source core helpers
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CORE_PATH="$SCRIPT_DIR/BZQ-cli/bzq-core.sh"
if [ -f "$CORE_PATH" ]; then
  source "$CORE_PATH"
else
  echo -e "\033[0;31m✘ ERROR:\033[0m BZQ core helper file not found at $CORE_PATH" >&2
  exit 1
fi

check_dependencies
check_auth

# Help Usage Details
show_help() {
  log_banner
  echo -e "${BOLD}USAGE:${NC}"
  echo -e "  ./bzq <command> [arguments] [options]"
  echo ""
  echo -e "${BOLD}COMMANDS:${NC}"
  echo -e "  ${BOLD}login${NC}                                 Authenticate clasp with your Google Account."
  echo -e "  ${BOLD}init <folder> [parent-folder-id]${NC}      Initialize a new script project, optionally in a parent folder."
  echo -e "  ${BOLD}pull <folder> [script-id] [options]${NC}    Sync down / clone files from Google Apps Script."
  echo -e "  ${BOLD}push [<folder> | --all] [options]${NC}     Push local files up to Google Apps Script."
  echo -e "  ${BOLD}deploy <folder> [description]${NC}          Create a new versioned deployment of the project."
  echo -e "  ${BOLD}status <folder>${NC}                        Check local/remote sync status of files."
  echo -e "  ${BOLD}link-gcp <folder> <project-id>${NC}        Link the script project to a Google Cloud Project."
  echo -e "  ${BOLD}bootstrap-dev <env-name> <parent-id> [project-number]${NC}  Deploy a complete fresh dev environment with seeded data."
  echo -e "  ${BOLD}deploy-core <env-name> <parent-id>${NC}    Deploy central script modules without seeding or GCP projects."
  echo -e "  ${BOLD}link-gcp-all <env-name> <project-num>${NC} Associate central script modules with a GCP project."
  echo -e "  ${BOLD}seed-db <env-name> <parent-id> [project-num]${NC} Run database seeding and configuration setup worksheets."
  echo -e "  ${BOLD}create-spoke <name> <env> <parent-id> [num]${NC}  Provision a single Spoke spreadsheet and bound script triggers."
  echo -e "  ${BOLD}install-module <module-name> <env-name> <parent-id>${NC} Install/configure a module on an existing environment."
  echo ""
  echo -e "${BOLD}PULL OPTIONS:${NC}"
  echo -e "  ${BOLD}-d, --latest-deployed${NC}                 Query deployments and pull the latest deployed version."
  echo -e "  ${BOLD}-f, --force${NC}                           Force pull, deleting local files that do not exist remotely."
  echo ""
  echo -e "${BOLD}PUSH OPTIONS:${NC}"
  echo -e "  ${BOLD}-w, --watch${NC}                           Watch for local changes and push them automatically (single package only)."
  echo -e "  ${BOLD}-a, --all${NC}                             Push all initialized packages."
  echo -e "  ${BOLD}-x, --exclude <list>${NC}                  Comma-separated list of packages to exclude when using --all."
  echo ""
  echo -e "${BOLD}EXAMPLES:${NC}"
  echo -e "  ${CYAN}# Authenticate first${NC}"
  echo -e "  ./bzq login"
  echo ""
  echo -e "  ${CYAN}# Clone a project for the first time${NC}"
  echo -e "  ./bzq pull AppsUtilities 1A2B3C4D5E6F7G8H..."
  echo ""
  echo -e "  ${CYAN}# Pull the latest HEAD (development) revision${NC}"
  echo -e "  ./bzq pull AppsUtilities"
  echo ""
  echo -e "  ${CYAN}# Pull the latest DEPLOYED production version${NC}"
  echo -e "  ./bzq pull AppsUtilities --latest-deployed"
  echo ""
  echo -e "  ${CYAN}# Push your local changes back to the workbook script${NC}"
  echo -e "  ./bzq push AppsUtilities"
  echo ""
  exit 0
}

# Main routing logic
COMMAND="$1"
shift

case "$COMMAND" in
  login)
    log_info "Initializing clasp login. This will open a browser window..."
    npx @google/clasp login
    if [ $? -eq 0 ]; then
      log_success "clasp authentication successfully completed!"
    else
      log_error "clasp login failed."
    fi
    ;;

  pull)
    # Parse pull arguments
    FOLDER=""
    SCRIPT_ID=""
    LATEST_DEPLOYED=false
    FORCE_PULL=false

    while [ $# -gt 0 ]; do
      case "$1" in
        -d|--latest-deployed)
          LATEST_DEPLOYED=true
          shift
          ;;
        -f|--force)
          FORCE_PULL=true
          shift
          ;;
        -*)
          log_error "Unknown option: $1. Run './bzq' for usage instructions."
          ;;
        *)
          if [ -z "$FOLDER" ]; then
            FOLDER="$1"
          elif [ -z "$SCRIPT_ID" ]; then
            SCRIPT_ID="$1"
          else
            log_error "Unexpected argument: $1. Run './bzq' for usage instructions."
          fi
          shift
          ;;
      esac
    done

    if [ -z "$FOLDER" ]; then
      log_error "Missing required <folder> argument. Example: './bzq pull AppsUtilities'"
    fi

    TARGET_DIR="$SCRIPT_DIR/$FOLDER"
    CLASP_CONFIG="$TARGET_DIR/.clasp.json"

    if [ ! -f "$CLASP_CONFIG" ]; then
      # Cloning a new project (first-time sync)
      if [ -z "$SCRIPT_ID" ]; then
        log_error "No project config (.clasp.json) found in '$FOLDER'.\n   You must provide a [script-id] to clone this project for the first time.\n   Example: './bzq pull $FOLDER <script-id>'"
      fi

      log_info "Initializing project clone for '$FOLDER' with Script ID: $SCRIPT_ID..."
      mkdir -p "$TARGET_DIR"

      # Determine version if --latest-deployed is selected
      VERSION=""
      if [ "$LATEST_DEPLOYED" = true ]; then
        log_info "Querying deployments for Script ID $SCRIPT_ID..."
        VERSION=$(npx @google/clasp deployments "$SCRIPT_ID" 2>/dev/null | grep -o "@[0-9]\+" | tail -n 1 | tr -d "@")
        if [ -n "$VERSION" ]; then
          log_success "Found latest deployed version: @$VERSION"
        else
          log_warn "No deployments found. Cloning HEAD revision."
        fi
      fi

      (
        cd "$TARGET_DIR" || log_error "Failed to access directory $TARGET_DIR"
        if [ -n "$VERSION" ]; then
          npx @google/clasp clone "$SCRIPT_ID" "$VERSION"
        else
          npx @google/clasp clone "$SCRIPT_ID"
        fi
      )

      if [ $? -eq 0 ]; then
        ensure_claspignore "$TARGET_DIR"
        log_success "Successfully synced down project to '$FOLDER'!"
      else
        log_error "Failed to clone script. Ensure your Script ID is correct and you are authenticated."
      fi
    else
      # Pulling an existing project
      if [ -n "$SCRIPT_ID" ]; then
        log_warn "Project already configured in '$FOLDER'. Ignoring provided Script ID."
      fi

      log_info "Syncing down latest files in folder '$FOLDER'..."
      ensure_claspignore "$TARGET_DIR"

      # Prepare clasp pull arguments
      PULL_ARGS=()
      if [ "$LATEST_DEPLOYED" = true ]; then
        VERSION=$(get_latest_deployment_version "$TARGET_DIR")
        if [ "$VERSION" != "HEAD" ]; then
          log_info "Targeting latest deployed version: @$VERSION"
          PULL_ARGS+=("--versionNumber" "$VERSION")
        fi
      fi

      if [ "$FORCE_PULL" = true ]; then
        PULL_ARGS+=("-f")
      fi

      (
        cd "$TARGET_DIR" || log_error "Failed to access directory $TARGET_DIR"
        npx @google/clasp pull "${PULL_ARGS[@]}"
      )

      if [ $? -eq 0 ]; then
        log_success "Successfully pulled project in '$FOLDER'!"
      else
        log_error "Failed to pull files. Run with --force or check connection."
      fi
    fi
    ;;

  push)
    FOLDER=""
    WATCH=false
    PUSH_ALL=false
    EXCLUDE=""

    while [ $# -gt 0 ]; do
      case "$1" in
        -w|--watch)
          WATCH=true
          shift
          ;;
        -a|--all)
          PUSH_ALL=true
          shift
          ;;
        -x|--exclude)
          if [ -n "$2" ] && [[ "$2" != -* ]]; then
            EXCLUDE="$2"
            shift 2
          else
            log_error "Option --exclude requires a list argument."
          fi
          ;;
        -*)
          log_error "Unknown option: $1. Run './bzq' for usage instructions."
          ;;
        *)
          if [ -z "$FOLDER" ]; then
            FOLDER="$1"
          else
            log_error "Unexpected argument: $1. Run './bzq' for usage instructions."
          fi
          shift
          ;;
      esac
    done

    # Validation Rules
    if [ "$PUSH_ALL" = true ]; then
      if [ -n "$FOLDER" ]; then
        log_error "Cannot specify a target folder when using --all. Did you mean to use --exclude?"
      fi
      if [ "$WATCH" = true ]; then
        log_error "Watch mode is only supported when pushing a single package."
      fi
    else
      if [ -z "$FOLDER" ]; then
        log_error "Missing required <folder> argument or --all flag. Example: './bzq push AppsUtilities' or './bzq push --all'"
      fi
      if [ -n "$EXCLUDE" ]; then
        log_error "Exclusions are only supported when using --all."
      fi
    fi

    # Helper function to check if a folder is in the exclusion list
    is_excluded() {
      local item="$1"
      local list="$2"
      local IFS=','
      local element
      for element in $list; do
        if [ "$element" = "$item" ]; then
          return 0 # True (excluded)
        fi
      done
      return 1 # False (not excluded)
    }

    if [ "$PUSH_ALL" = true ]; then
      # Discover packages containing .clasp.json
      REPOS_DIR="$SCRIPT_DIR"
      folders=()
      for d in "$REPOS_DIR"/*/; do
        if [ -f "${d}.clasp.json" ]; then
          name=$(basename "$d")
          folders+=("$name")
        fi
      done

      if [ ${#folders[@]} -eq 0 ]; then
        log_error "No initialized Google Apps Script projects found in this repository."
      fi

      success_count=0
      fail_count=0
      failed_folders=()
      skipped_folders=()

      for folder in "${folders[@]}"; do
        if is_excluded "$folder" "$EXCLUDE"; then
          log_info "Skipping excluded package '$folder'..."
          skipped_folders+=("$folder")
          continue
        fi

        log_banner
        log_info "Pushing local modifications for package: $folder"
        TARGET_DIR="$REPOS_DIR/$folder"
        ensure_claspignore "$TARGET_DIR"

        push_output=$(mktemp)
        (
          cd "$TARGET_DIR" || exit 1
          npx @google/clasp push 2>&1 | tee "$push_output"
          exit ${PIPESTATUS[0]}
        )
        push_status=$?

        if [ $push_status -ne 0 ]; then
          if grep -qE '"error":"invalid_grant"|invalid_rapt|reauth|Authentication|Authorization|login' "$push_output"; then
            rm -f "$push_output"
            log_auth_failure
          fi
        fi
        rm -f "$push_output"

        if [ $push_status -eq 0 ]; then
          log_success "Pushed code successfully for $folder!"
          success_count=$((success_count + 1))
        else
          log_failure "Failed to push files for $folder."
          fail_count=$((fail_count + 1))
          failed_folders+=("$folder")
        fi
      done

      # Push Summary
      log_banner
      log_info "Push Summary:"
      log_success "Successfully pushed: $success_count package(s)"
      if [ ${#skipped_folders[@]} -gt 0 ]; then
        log_info "Skipped (excluded): ${skipped_folders[*]}"
      fi
      if [ $fail_count -gt 0 ]; then
        log_warn "Failed to push: ${failed_folders[*]}"
        exit 1
      else
        log_success "All selected packages pushed successfully!"
      fi

    else
      # Single folder push
      TARGET_DIR="$SCRIPT_DIR/$FOLDER"
      CLASP_CONFIG="$TARGET_DIR/.clasp.json"

      if [ ! -f "$CLASP_CONFIG" ]; then
        log_error "Project not initialized in '$FOLDER'. Run './bzq pull $FOLDER <script-id>' first."
      fi

      ensure_claspignore "$TARGET_DIR"

      push_output=$(mktemp)
      (
        cd "$TARGET_DIR" || log_error "Failed to access directory $TARGET_DIR"
        if [ "$WATCH" = true ]; then
          log_info "Watching local files for automatic pushes to Google Apps Script..."
          npx @google/clasp push --watch
        else
          log_info "Pushing local modifications to Google Apps Script..."
          npx @google/clasp push 2>&1 | tee "$push_output"
          exit ${PIPESTATUS[0]}
        fi
      )
      push_status=$?

      if [ "$WATCH" = false ]; then
        if [ $push_status -ne 0 ]; then
          if grep -qE '"error":"invalid_grant"|invalid_rapt|reauth|Authentication|Authorization|login' "$push_output"; then
            rm -f "$push_output"
            log_auth_failure
          fi
          rm -f "$push_output"
          log_error "Failed to push files."
        else
          rm -f "$push_output"
          log_success "Pushed code successfully to Google Sheets!"
        fi
      fi
    fi
    ;;

  deploy)
    FOLDER="$1"
    DESC="$2"

    if [ -z "$FOLDER" ]; then
      log_error "Missing required <folder> argument. Example: './bzq deploy AppsUtilities \"v1.0.0 Release\"'"
    fi

    TARGET_DIR="$SCRIPT_DIR/$FOLDER"
    CLASP_CONFIG="$TARGET_DIR/.clasp.json"

    if [ ! -f "$CLASP_CONFIG" ]; then
      log_error "Project not initialized in '$FOLDER'. Run './bzq pull $FOLDER <script-id>' first."
    fi

    (
      cd "$TARGET_DIR" || log_error "Failed to access directory $TARGET_DIR"
      if [ -n "$DESC" ]; then
        log_info "Creating a new deployment with description: '$DESC'..."
        npx @google/clasp deploy --description "$DESC"
      else
        log_info "Creating a new versioned deployment..."
        npx @google/clasp deploy
      fi
    )

    if [ $? -eq 0 ]; then
      log_success "Deployment created successfully!"
      if [ "$FOLDER" = "bzq_gwao" ]; then
        log_banner
        log_success "DEVELOPER MODE INSTALLATION GUIDE:"
        log_info "1. Open script in editor: https://script.google.com/d/180Z9oAaNeouz_qF7U-qGL65rckWAb7_AUChQTUPNbB3YdiycLg4Y8ODw/edit"
        log_info "2. Click 'Deploy' -> 'Test deployments' in top-right toolbar."
        log_info "3. Under 'BZQ ERP', click 'Install' for Sheets and Drive."
        log_info "4. Open or refresh Sheets/Drive; the BZQ icon will appear in the right sidebar!"
        log_banner
      fi
    else
      log_error "Failed to create deployment."
    fi
    ;;

  status)
    FOLDER="$1"

    if [ -z "$FOLDER" ]; then
      log_error "Missing required <folder> argument. Example: './bzq status AppsUtilities'"
    fi

    TARGET_DIR="$SCRIPT_DIR/$FOLDER"
    CLASP_CONFIG="$TARGET_DIR/.clasp.json"

    if [ ! -f "$CLASP_CONFIG" ]; then
      log_error "Project not initialized in '$FOLDER'. Run './bzq pull $FOLDER <script-id>' first."
    fi

    (
      cd "$TARGET_DIR" || log_error "Failed to access directory $TARGET_DIR"
      npx @google/clasp status
    )
    ;;

  link-gcp)
    FOLDER="$1"
    PROJECT_ID="$2"
    if [ -z "$FOLDER" ] || [ -z "$PROJECT_ID" ]; then
      log_error "Usage: ./bzq link-gcp <folder> <gcp-project-id>"
    fi
    link_gcp_project "$FOLDER" "$PROJECT_ID"
    ;;

  init)
    FOLDER="$1"
    PARENT_ID="$2"
    if [ -z "$FOLDER" ]; then
      log_error "Usage: ./bzq init <folder> [parent-folder-id]"
    fi
    init_script_project "$FOLDER" "$PARENT_ID"
    ;;

  bootstrap-dev)
    ENV_NAME="$1"
    PARENT_ID="$2"
    PROJECT_NUMBER="$3"
    if [ -z "$ENV_NAME" ] || [ -z "$PARENT_ID" ]; then
      log_error "Usage: ./bzq bootstrap-dev <env-name> <parent-folder-id> [project-number]"
    fi
    bootstrap_dev_environment "$ENV_NAME" "$PARENT_ID" "$PROJECT_NUMBER"
    ;;

  deploy-core)
    ENV_NAME="$1"
    PARENT_ID="$2"
    if [ -z "$ENV_NAME" ] || [ -z "$PARENT_ID" ]; then
      log_error "Usage: ./bzq deploy-core <env-name> <parent-folder-id>"
    fi
    deploy_core "$ENV_NAME" "$PARENT_ID"
    ;;

  link-gcp-all)
    ENV_NAME="$1"
    PROJECT_NUMBER="$2"
    if [ -z "$ENV_NAME" ] || [ -z "$PROJECT_NUMBER" ]; then
      log_error "Usage: ./bzq link-gcp-all <env-name> <project-number>"
    fi
    link_gcp_all "$ENV_NAME" "$PROJECT_NUMBER"
    ;;

  seed-db)
    ENV_NAME="$1"
    PARENT_ID="$2"
    PROJECT_NUMBER="$3"
    if [ -z "$ENV_NAME" ] || [ -z "$PARENT_ID" ]; then
      log_error "Usage: ./bzq seed-db <env-name> <parent-folder-id> [project-number]"
    fi
    seed_db "$ENV_NAME" "$PARENT_ID" "$PROJECT_NUMBER"
    ;;

  create-spoke)
    SPOKE_NAME="$1"
    ENV_NAME="$2"
    PARENT_ID="$3"
    PROJECT_NUMBER="$4"
    if [ -z "$SPOKE_NAME" ] || [ -z "$ENV_NAME" ] || [ -z "$PARENT_ID" ]; then
      log_error "Usage: ./bzq create-spoke <spoke-name> <env-name> <parent-folder-id> [project-number]"
    fi
    node "$SCRIPT_DIR/scripts/create-spoke.js" "$SPOKE_NAME" "$ENV_NAME" "$PARENT_ID" "$PROJECT_NUMBER"
    ;;

  install-module)
    MODULE_NAME="$1"
    ENV_NAME="$2"
    PARENT_ID="$3"
    if [ -z "$MODULE_NAME" ] || [ -z "$ENV_NAME" ] || [ -z "$PARENT_ID" ]; then
      log_error "Usage: ./bzq install-module <module-name> <env-name> <parent-folder-id>"
    fi
    install_module "$MODULE_NAME" "$ENV_NAME" "$PARENT_ID"
    ;;

  *)
    show_help
    ;;
esac
